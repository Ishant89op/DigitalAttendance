# ─────────────────────────────────────────────
# AttendX — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────

# PostgreSQL (pgcrypto extension is enabled automatically)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_system
DB_USER=postgres
DB_PASSWORD=

# Server — binds to localhost by default. To serve classroom devices on the
# LAN, set ATTENDX_HOST=0.0.0.0 AND add the hostname/IP below.
ATTENDX_HOST=127.0.0.1
ATTENDX_PORT=8000
ATTENDX_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Only needed if the UI is served from a different origin (normally empty).
ATTENDX_CORS_ORIGINS=
# Swagger UI at /docs (keep off in production).
ATTENDX_ENABLE_DOCS=false
# Secure cookie flag: auto (HTTPS only) | true | false
ATTENDX_COOKIE_SECURE=auto
ATTENDX_SESSION_IDLE_MINUTES=30
ATTENDX_SESSION_ABSOLUTE_HOURS=12

# Keys (base64, 32 bytes). Leave empty to auto-generate into instance/.
# Generate with: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# BACK UP ATTENDX_DATA_KEY — face templates cannot be decrypted without it.
ATTENDX_SECRET_KEY=
ATTENDX_DATA_KEY=

# First admin account. If ADMIN_LOGIN_PASSWORD is empty or weak, a one-time
# password is written to instance/initial_admin_password.txt instead.
ADMIN_LOGIN_ID=admin
ADMIN_LOGIN_PASSWORD=

# Recognition device
CLASSROOM_ID=CR-2113
ATTENDX_STRICT_CONFIDENCE=true
ATTENDX_ENABLE_LIVENESS=true
ATTENDX_REQUIRE_BLINK_LIVENESS=true
